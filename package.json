{
  "name": "ministation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "start": "node server/index.mjs",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node --check server/app.mjs && node --check server/gateway.mjs && npm run build && npm test",
    "fixture": "node scripts/fixture.mjs",
    "test:e2e": "playwright test",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "8.11.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "vite": "8.3.4"
  },
  "license": "MIT"
}
